# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Auth user UUID allowed to administer this portfolio
ADMIN_USER_ID=your-auth-user-uuid

# Resend API key and a verified sender domain (Resend onboarding address works for initial setup)
RESEND_API_KEY=re_your_key
CONTACT_EMAIL=oluwatoyinferanmijohn@gmail.com
FROM_EMAIL=Portfolio <hello@your-verified-domain.com>

# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:oluwatoyinferanmijohn@gmail.com

# Optional public CV URL (upload a PDF to your own hosting and paste the link)
NUXT_PUBLIC_CV_URL=

# Optional canonical site origin
NUXT_PUBLIC_SITE_URL=https://your-domain.com
